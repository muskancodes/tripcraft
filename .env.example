# ── Required for hosted/Railway deployment ─────────────────────────

# Set to "true" when deployed on Railway so the server serves the built frontend
HOSTED=true

# Password to access your personal hosted app (choose something strong)
APP_PASSWORD=your_password_here

# ── AI (pick one — Gemini is free, Claude is paid) ────────────────

# Option 1: Google Gemini — FREE
# Get key at https://aistudio.google.com/apikey (sign in with Google, click "Get API Key")
GEMINI_API_KEY=

# Option 2: Anthropic Claude — paid ($5 minimum, very cheap per message)
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# If both are set, Claude takes priority.

# Port (Railway sets this automatically — don't change)
PORT=3001
