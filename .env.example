# ── Required for hosted/Railway deployment ─────────────────────────

# Set to "true" when deployed on Railway so the server serves the built frontend
HOSTED=true

# Password to access your personal hosted app (choose something strong)
APP_PASSWORD=your_password_here

# Your Claude API key for AI features
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Port (Railway sets this automatically — don't change)
PORT=3001
